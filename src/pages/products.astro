---
// src/pages/products.astro
// Products catalog (default locale: en). Lists every registered product with
// its one-line description and links to the product landing + source. The
// non-default-locale twin lives at src/pages/[locale]/products.astro.
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Media from '../components/Media.astro';
import { products } from '../../site.config';
import { t, localizePath, withBase, buildAlternates } from '../lib/i18n';

const c = t.en;
const alternates = buildAlternates('/products');
---

<Layout title={c.productsPageTitle} description={c.productsPageLead} locale="en" alternates={alternates}>
  <Nav alternates={alternates} />

  <main data-pagefind-body>
    <section class="section">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">{c.productsPageEyebrow}</p>
          <h1>{c.productsPageTitle}</h1>
          <p class="section-lead">{c.productsPageLead}</p>
        </div>
        <div class="products-grid">
          {
            products.map((p) => (
              <div class="project-card">
                <div class="project-info">
                  <div class="project-header">
                    {p.logo && (
                      <div class="project-logo">
                        <Media media={p.logo} alt={`${p.name} logo`} shape="card" size={48} />
                      </div>
                    )}
                    <h3>
                      <a class="project-card-link" href={withBase(localizePath(`/${p.slug}`, 'en'))}>{p.name}</a>
                    </h3>
                  </div>
                  <p class="project-desc">{p.description.en}</p>
                  <div class="project-meta">
                    {p.badges.map((b) => (
                      <span class="badge badge-soft">{b}</span>
                    ))}
                  </div>
                  <div class="project-actions">
                    <a href={p.github} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
                      GitHub
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
