---
// src/pages/[product]/docs/index.astro
// Generic product docs overview page (default locale: en).
import DocsLayout from '../../../components/DocsLayout.astro';
import { getLocalizedDocIndex } from '../../../lib/content';
import { buildAlternates, withBase } from '../../../lib/i18n';
import { products } from '../../../../site.config';

export function getStaticPaths() {
  return products.map((p) => ({
    params: { product: p.slug },
    props: { product: p.slug },
  }));
}

const { product } = Astro.props;
const basePath = `/${product}/docs`;
const page = await getLocalizedDocIndex(product, 'en', basePath);
// Resolve the redirect target outside the `return` so astro check counts
// `withBase` as used (refs inside a frontmatter `return` are ignored by the
// checker — see withastro/astro#14684).
const redirectTarget = withBase(basePath);
if (!page || !redirectTarget) return Astro.redirect(redirectTarget);
const { Content, title, description, navItems, isFallback, headings } = page;
const alternates = buildAlternates(basePath);
---

<DocsLayout
  title={title}
  description={description}
  sidebarTitle={`${product} Docs`}
  productName={product}
  productHref={`/${product}`}
  navItems={navItems}
  locale="en"
  isFallback={isFallback}
  alternates={alternates}
  headings={headings}
  productSlug={product}
>
  <Content />
</DocsLayout>
