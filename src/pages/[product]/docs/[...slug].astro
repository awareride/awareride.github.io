---
// src/pages/[product]/docs/[...slug].astro
// Catch-all route for product docs (default locale: en, no URL prefix).
import DocsLayout from '../../../components/DocsLayout.astro';
import { getLocalizedPaths, renderLocalizedPage } from '../../../lib/content';
import { buildAlternates, withBase } from '../../../lib/i18n';
import { products } from '../../../../site.config';

export async function getStaticPaths() {
  const paths: { params: { product: string; slug: string }; props: { product: string } }[] = [];
  for (const p of products) {
    const basePath = `/${p.slug}/docs`;
    const localized = await getLocalizedPaths(p.slug, basePath, 'en');
    for (const lp of localized) {
      paths.push({ params: { product: p.slug, slug: lp.params.slug }, props: { product: p.slug } });
    }
  }
  return paths;
}

const { product } = Astro.props;
const { slug } = Astro.params;
const basePath = `/${product}/docs`;
const page = await renderLocalizedPage(product, 'en', slug, basePath);
// Resolve the redirect target outside the `return` so astro check counts
// `withBase` as used (refs inside a frontmatter `return` are ignored by the
// checker — see withastro/astro#14684).
const redirectTarget = withBase(basePath);
if (!page || !redirectTarget) return Astro.redirect(redirectTarget);
const { Content, title, description, navItems, isFallback, headings } = page;
const alternates = buildAlternates(`${basePath}/${slug}`);
---

<DocsLayout
  title={title}
  description={description}
  sidebarTitle={`${product} Docs`}
  productName={product}
  productHref={`/${product}`}
  navItems={navItems}
  locale="en"
  isFallback={isFallback}
  alternates={alternates}
  headings={headings}
  productSlug={product}
>
  <Content />
</DocsLayout>
