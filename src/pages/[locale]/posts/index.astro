---
// src/pages/[locale]/posts/index.astro
// Blog listing for non-default locales (e.g. /zh-Hans/posts/). Posts without
// a localized version fall back to the default-locale content and are marked
// on the card. The default-locale listing is src/pages/posts/index.astro.
import Layout from '../../../components/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import { getLocalizedPosts, getAllTags } from '../../../lib/content';
import { buildAlternates, localizePath, withBase, t, defaultLocale, locales, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return locales
    .filter((l): l is Locale => l !== defaultLocale)
    .map((l) => ({ params: { locale: l }, props: { locale: l } }));
}

const { locale } = Astro.props;
const ui = t[locale];
const items = await getLocalizedPosts(locale);
const sorted = items.sort(
  (a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime(),
);
const tags = (await getAllTags(locale)).slice(0, 12);
const alternates = buildAlternates('/posts');

function dirname(id: string) {
  const parts = id.split('/');
  return parts.length > 1 ? parts.slice(0, -1).join('/') : null;
}
---

<Layout
  title={ui.postsListTitle}
  description={ui.postsDescription}
  locale={locale}
  alternates={alternates}
>
  <Nav alternates={alternates} />

  <main data-pagefind-body>
    <section class="hero" style="padding-bottom: 2rem;">
      <div class="container">
        <p class="eyebrow">{ui.postsListEyebrow}</p>
        <h1>{ui.postsListTitle}</h1>
        <p class="hero-lead" style="margin-top: 0.5rem;">
          {ui.postsListLead}
        </p>
      </div>
    </section>

    <section class="section" style="padding-top: 1rem;">
      <div class="container">
        {tags.length > 0 && (
          <div class="posts-tag-row">
            {tags.map(tag => (
              <a class="tag tag-link" href={withBase(localizePath(`/posts/tags/${tag.slug}`, locale))}>
                {tag.label}<span class="tag-count">{tag.count}</span>
              </a>
            ))}
          </div>
        )}
        {
          sorted.length === 0 ? (
            <p style="text-align:center; color:var(--color-text-muted);">
              {ui.noPosts}
            </p>
          ) : (
            <div class="posts-grid">
              {sorted.map(({ entry, isFallback }) => (
                <PostCard
                  title={entry.data.title}
                  date={entry.data.date}
                  description={entry.data.description}
                  tags={entry.data.tags}
                  slug={entry.id}
                  source={dirname(entry.id)}
                  isFallback={isFallback}
                  locale={locale}
                />
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
