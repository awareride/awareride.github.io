---
// src/pages/[locale]/posts/tags/[tag].astro
// Tag listing for non-default locales (e.g. /zh-Hans/posts/tags/i18n/).
// Delegates to the shared TagPage component (same as the default-locale route).
import TagPage from '../../../../components/TagPage.astro';
import { getAllTags, getPostsByTag, type TagInfo } from '../../../../lib/content';
import { buildAlternates, defaultLocale, locales, type Locale } from '../../../../lib/i18n';

export async function getStaticPaths() {
  const paths: { params: { locale: Locale; tag: string }; props: { tag: TagInfo; locale: Locale } }[] = [];
  for (const l of locales) {
    if (l === defaultLocale) continue;
    const tags = await getAllTags(l);
    for (const tag of tags) {
      paths.push({ params: { locale: l, tag: tag.slug }, props: { tag, locale: l } });
    }
  }
  return paths;
}

const { tag, locale } = Astro.props;
const posts = await getPostsByTag(locale, tag.label);
const alternates = buildAlternates(`/posts/tags/${tag.slug}`);
---

<TagPage tag={tag} posts={posts} locale={locale} alternates={alternates} />
