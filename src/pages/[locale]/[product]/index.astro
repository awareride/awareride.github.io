---
// src/pages/[locale]/[product]/index.astro
// Product landing for non-default locales (e.g. /zh-Hans/vite/).
// The default-locale route is src/pages/[product]/index.astro (prefix-free).
import Layout from '../../../components/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import ProductLandingDefault from '../../../components/ProductLandingDefault.astro';
import { getProductLanding } from '../../../lib/product-landing';
import { productCopy, localizePath, withBase, buildAlternates, defaultLocale, locales, type Locale } from '../../../lib/i18n';
import { products, type Product } from '../../../../site.config';

export function getStaticPaths() {
  const paths: { params: { locale: Locale; product: string }; props: { product: Product; locale: Locale } }[] = [];
  for (const l of locales) {
    if (l === defaultLocale) continue;
    for (const p of products) {
      paths.push({ params: { locale: l, product: p.slug }, props: { product: p, locale: l } });
    }
  }
  return paths;
}

const { product, locale } = Astro.props;
const c = productCopy[locale];
const docsHref = withBase(localizePath(`/${product.slug}/docs`, locale));
const alternates = buildAlternates(`/${product.slug}`);
// Per-product override: if `src/components/product-landing/<slug>.astro` exists
// it replaces the generic hero+CTA; otherwise ProductLandingDefault is used.
// The override renders only <main> sections; Layout/Nav/Footer stay here.
const Override = getProductLanding(product.slug);
---

<Layout title={product.name} description={c.metaDescription.replace('{name}', product.name)} locale={locale} alternates={alternates} productSlug={product.slug}>
  <Nav alternates={alternates} />

  <main data-pagefind-body data-pagefind-filter="scope:products">
    <span data-pagefind-filter={`product:${product.slug}`} hidden aria-hidden="true"></span>
    {Override ? (
      <Override product={product} locale={locale} c={c} docsHref={docsHref} />
    ) : (
      <ProductLandingDefault product={product} locale={locale} c={c} docsHref={docsHref} />
    )}
  </main>

  <Footer />
</Layout>
