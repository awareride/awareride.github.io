---
// src/pages/404.astro
// Custom 404 page. Astro emits dist/404.html, which GitHub Pages and Cloudflare
// Pages serve automatically for any not-found path. It is a single locale-aware
// file (rendered in the default locale) - a static 404 cannot know the failed
// URL at build time, so a localized 404 shell is left as a future enhancement.
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { buildAlternates, withBase } from '../lib/i18n';
import { products } from '../../site.config';

const alternates = buildAlternates('/');
---

<Layout title="Page not found" description="The page you were looking for could not be found." locale="en" alternates={alternates}>
  <Nav alternates={alternates} />

  <main data-pagefind-ignore>
    <section class="hero" style="padding: 6rem 0;">
      <div class="container" style="text-align: center; max-width: 640px;">
        <p class="eyebrow">404</p>
        <h1 class="hero-title">Page not found</h1>
        <p class="hero-lead">
          The page you were looking for doesn't exist or may have moved.
        </p>
        <div class="hero-actions" style="justify-content: center;">
          <a href={withBase('/')} class="btn btn-primary">Back home</a>
          <a href={withBase('/posts')} class="btn btn-secondary">Browse posts</a>
        </div>
        {products.length > 0 && (
          <p style="margin-top: 2rem; color: var(--color-text-muted); font-size: 0.9rem;">
            Looking for docs? Try the
            <a href={withBase(`/${products[0].slug}/docs`)} style="color: var(--color-text); text-decoration: underline;">
              {products[0].name} docs
            </a>.
          </p>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
