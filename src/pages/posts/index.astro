---
// src/pages/posts/index.astro
// Blog listing page (default locale: en). Grouped by source directory.
import Layout from '../../components/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getLocalizedPosts } from '../../lib/content';
import { getAllTags } from '../../lib/content';
import { buildAlternates, localizePath, withBase, t } from '../../lib/i18n';

const items = await getLocalizedPosts('en');
const sorted = items.sort(
  (a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime(),
);
const tags = (await getAllTags('en')).slice(0, 12);
const alternates = buildAlternates('/posts');
const ui = t.en;

function dirname(id: string) {
  const parts = id.split('/');
  return parts.length > 1 ? parts.slice(0, -1).join('/') : null;
}
---

<Layout
  title={ui.postsListTitle}
  description={ui.postsDescription}
  locale="en"
  alternates={alternates}
>
  <Nav alternates={alternates} />

  <main data-pagefind-body>
    <section class="hero" style="padding-bottom: 2rem;">
      <div class="container">
        <p class="eyebrow">{ui.postsListEyebrow}</p>
        <h1>{ui.postsListTitle}</h1>
        <p class="hero-lead" style="margin-top: 0.5rem;">
          {ui.postsListLead}
        </p>
      </div>
    </section>

    <section class="section" style="padding-top: 1rem;">
      <div class="container">
        {tags.length > 0 && (
          <div class="posts-tag-row">
            {tags.map(tag => (
              <a class="tag tag-link" href={withBase(localizePath(`/posts/tags/${tag.slug}`, 'en'))}>
                {tag.label}<span class="tag-count">{tag.count}</span>
              </a>
            ))}
          </div>
        )}
        {
          sorted.length === 0 ? (
            <p style="text-align:center; color:var(--color-text-muted);">
              {ui.noPosts}
            </p>
          ) : (
            <div class="posts-grid">
              {sorted.map(({ entry, isFallback }) => (
                <PostCard
                  title={entry.data.title}
                  date={entry.data.date}
                  description={entry.data.description}
                  tags={entry.data.tags}
                  slug={entry.id}
                  source={dirname(entry.id)}
                  isFallback={isFallback}
                  locale="en"
                />
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
