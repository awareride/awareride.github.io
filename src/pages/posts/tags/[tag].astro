---
// src/pages/posts/tags/[tag].astro
// Tag listing page (default locale: en). One static path per tag slug found
// across the localized-posts set. The label/count come from getAllTags so the
// display text matches the first post that used the tag.
import TagPage from '../../../components/TagPage.astro';
import { getAllTags, getPostsByTag } from '../../../lib/content';
import { buildAlternates } from '../../../lib/i18n';

export async function getStaticPaths() {
  const tags = await getAllTags('en');
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const posts = await getPostsByTag('en', tag.label);
const alternates = buildAlternates(`/posts/tags/${tag.slug}`);
---

<TagPage tag={tag} posts={posts} locale="en" alternates={alternates} />
