---
// src/pages/index.astro
// Landing Page (default locale: en). Copy lives in lib/i18n.ts `home`.
import Layout from '../components/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import Media from '../components/Media.astro';
import { getLocalizedPosts } from '../lib/content';
import { home, org, localizePath, withBase, buildAlternates, locales } from '../lib/i18n';
import { products, site } from '../../site.config';

const c = home.en;
const o = org.en;
const items = await getLocalizedPosts('en');
const latestPosts = items
  .sort((a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime())
  .slice(0, 3);
const alternates = buildAlternates('/');
---

<Layout title={c.title} description={c.description} locale="en" alternates={alternates}>
  <Nav alternates={alternates} />

  <main data-pagefind-body>
    <!-- Hero -->
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-glow hero-glow-2" aria-hidden="true"></div>
      <div class="container">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1 class="hero-title">
          {c.heroTitleA}<br />
          <span class="gradient-text">{c.heroTitleB}</span>
        </h1>
        <p class="hero-lead">{c.heroLead}</p>
        <div class="hero-actions">
          <a href={site.orgUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
            {c.ctaGithub}
          </a>
          <a href={withBase(localizePath('/products/', 'en'))} class="btn btn-secondary">{c.ctaProducts}</a>
        </div>
      </div>
    </section>

    <!-- Mission: the organization's front door (driven by the `org` block in copy.ts) -->
    <section id="mission" class="section">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">{o.eyebrow}</p>
          <h2>{o.title}</h2>
          <p class="section-lead mission-lead">{o.mission}</p>
        </div>
        <div class="mission-links">
          {o.links.map((link: { label: string; href: string }) => (
            <a href={link.href} class="btn btn-secondary" target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Latest Posts -->
    {
      latestPosts.length > 0 && (
        <section class="section">
          <div class="container">
            <div class="section-header">
              <p class="eyebrow">{c.latestEyebrow}</p>
              <h2>{c.latestTitle}</h2>
            </div>
            <div class="posts-grid">
              {latestPosts.map(({ entry, isFallback }) => (
                <PostCard
                  title={entry.data.title}
                  date={entry.data.date}
                  description={entry.data.description}
                  tags={entry.data.tags}
                  slug={entry.id}
                  source={null}
                  isFallback={isFallback}
                  locale="en"
                />
              ))}
            </div>
            <div style="text-align:center; margin-top:2rem;">
              <a href={withBase(localizePath('/posts', 'en'))} class="btn btn-secondary">{c.allPosts}</a>
            </div>
          </div>
        </section>
      )
    }

    <!-- Stats (data-driven, mirrors the product landing stats) -->
    <section class="section section-alt">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">{c.homeStatsEyebrow}</p>
          <h2>{c.homeStatsTitle}</h2>
        </div>
        <div class="stats-row">
          <div class="stats-item">
            <div class="stats-value">{products.length}</div>
            <div class="stats-label">{c.homeStatsProducts}</div>
          </div>
          <div class="stats-item">
            <div class="stats-value">{locales.length}</div>
            <div class="stats-label">{c.homeStatsLocales}</div>
          </div>
          <div class="stats-item">
            <div class="stats-value">65</div>
            <div class="stats-label">{c.homeStatsPages}</div>
          </div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="section section-alt">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">{c.focusEyebrow}</p>
          <h2>{c.focusTitle}</h2>
          <p class="section-lead">{c.focusLead}</p>
        </div>
        <div class="cards-grid">
          <article class="card">
            <div class="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/>
              </svg>
            </div>
            <h3>{c.card1Title}</h3>
            <p>{c.card1Body}</p>
          </article>
          <article class="card">
            <div class="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="3"/><path d="M2 8h20M8 2v20"/>
              </svg>
            </div>
            <h3>{c.card2Title}</h3>
            <p>{c.card2Body}</p>
          </article>
          <article class="card">
            <div class="card-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z"/><path d="M12 7v5l3 3"/>
              </svg>
            </div>
            <h3>{c.card3Title}</h3>
            <p>{c.card3Body}</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Products -->
    <section id="products" class="section">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">{c.productsEyebrow}</p>
          <h2>{c.productsTitle}</h2>
        </div>
        <div class="products-grid">
          {products.map((p) => (
            <div class="project-card">
              <div class="project-info">
                <div class="project-header">
                  {p.logo && (
                    <div class="project-logo">
                      <Media media={p.logo} alt={`${p.name} logo`} shape="card" size={48} />
                    </div>
                  )}
                  <h3>
                    <a class="project-card-link" href={withBase(localizePath(`/${p.slug}`, 'en'))}>{p.name}</a>
                  </h3>
                </div>
                <p class="project-desc">{p.description.en}</p>
                <div class="project-meta">
                  {p.badges.map((b) => (
                    <span class="badge badge-soft">{b}</span>
                  ))}
                </div>
                <div class="project-actions">
                  <a href={p.github} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
                    GitHub
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Principles -->
    <section id="principles" class="section section-alt">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">{c.principlesEyebrow}</p>
          <h2>{c.principlesTitle}</h2>
        </div>
        <ul class="principles-list">
          <li>
            <strong>{c.principle1Title}</strong>
            {c.principle1Body}
          </li>
          <li>
            <strong>{c.principle2Title}</strong>
            {c.principle2Body}
          </li>
          <li>
            <strong>{c.principle3Title}</strong>
            {c.principle3Body}
          </li>
          <li>
            <strong>{c.principle4Title}</strong>
            {c.principle4Body}
          </li>
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="section">
      <div class="container">
        <div class="cta-box">
          <h2>{c.ctaTitle}</h2>
          <p>{c.ctaBody}</p>
          <div class="cta-actions">
            <a href={site.orgUrl} class="btn btn-primary btn-large" target="_blank" rel="noopener noreferrer">
              {c.ctaGithubOrg}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
