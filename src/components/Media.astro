---
// Media.astro - shared visual media renderer for landing cards.
//
// Renders a MediaSpec (src | fallback + gradient, shape, size). With `src`
// it emits an <img>; without it, a gradient chip with the fallback initials
// (or a bare gradient when no fallback text) - the zero-asset treatment.
// All cards (avatars, icon blocks, thumbnails) go through this so the media
// language stays consistent.
import { toMediaSpec, githubAvatarUrl, type MediaSpec } from '../lib/media';

interface Props {
  media: string | MediaSpec | undefined | null;
  alt?: string;
  /** Override shape when the caller needs a specific one (default: from spec). */
  shape?: 'round' | 'card';
  /** Override size in px (default: from spec, else 48). */
  size?: number;
}

const { media, alt = '', shape: shapeOverride, size: sizeOverride } = Astro.props;
const spec = toMediaSpec(media);
if (!spec) return null;
const shape = shapeOverride ?? spec.shape ?? 'card';
const size = sizeOverride ?? spec.size ?? 48;
const gradient = spec.gradient ?? 'linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-2) 50%, var(--color-accent-3) 100%)';
const cls = `media media--${shape}`;
// github username takes precedence over an explicit src (semantically the
// clearest signal); both fall back to the gradient chip.
const src = spec.github ? githubAvatarUrl(spec.github, size) : spec.src;
---

{src ? (
  <img class={cls} src={src} alt={alt} width={size} height={size} style="object-fit:cover" />
) : (
  <span class={cls} style={{ width: `${size}px`, height: `${size}px`, background: gradient }} aria-hidden={alt ? undefined : 'true'} role={alt ? 'img' : undefined}>
    {spec.fallback ?? ''}
  </span>
)}

<style>
  .media {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-weight: 700;
    color: var(--color-on-dark);
    letter-spacing: 0.02em;
  }
  .media--round {
    border-radius: 50%;
    overflow: hidden;
  }
  .media--card {
    border-radius: var(--radius);
    overflow: hidden;
  }
</style>
