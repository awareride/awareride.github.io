---
// src/components/landing-sections/features.astro
// Landing section: feature card grid (product-info `features`).
// Rendered by ProductLandingDefault via the section registry.
//
// Layout variants (data.layout):
//   - "grid" (default): even auto-fit columns - the classic 3-col icon grid.
//   - "bento": first card (or one flagged span: 2) spans two columns,
//     forming a 1-large + 2-small composition; large card gets an accent
//     treatment (bigger icon, more breathing room) - Linear/Notion style.
//
// Visual anchors per feature (via the shared media model):
//   - `icon`: a vector icon - string shorthand (single SVG path d) or an
//     IconSpec object ({ paths: [...], strokeWidth?, variant: outline|filled }).
//   - `image`: a MediaSpec (src | fallback+gradient) rendered as a card
//     thumbnail via Media.astro; with `cover: true` it becomes a full-card
//     background layer (bento lead-card treatment) with the text on top.
// A feature may carry either, neither, or (rarely) both.
import type { LandingSectionProps } from '../../lib/landing-sections';
import Media from '../Media.astro';
import { toIconSpec, iconSvgProps, type IconSpec } from '../../lib/media';

interface Props extends LandingSectionProps {}
type FeatureItem = {
  title: string;
  body: string;
  icon?: string | IconSpec;
  image?: string | { src?: string; fallback?: string; gradient?: string; cover?: boolean };
  span?: number;
};
const { data, product } = Astro.props as Props;
const cfg = (data && typeof data === 'object' && !Array.isArray(data) ? data : {}) as {
  layout?: 'grid' | 'bento';
  eyebrow?: string;
  title?: string;
  items?: FeatureItem[];
};
const features = Array.isArray(data)
  ? (data as FeatureItem[])
  : cfg.items ?? [];
if (features.length === 0) return null;
const layout = cfg.layout ?? 'grid';
const eyebrow = cfg.eyebrow ?? null;
const title = cfg.title ?? null;
void product;
---

<section class="section">
  <div class="container">
    {title && (
      <div class="section-header">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2>{title}</h2>
      </div>
    )}
    <div class:list={['feature-grid', { 'feature-grid--bento': layout === 'bento' }]}>
      {features.map((f, i) => {
        const isWide = f.span === 2 || (layout === 'bento' && i === 0 && features.length > 2);
        const icon = toIconSpec(f.icon);
        const isCover = typeof f.image === 'object' && f.image?.cover === true;
        return (
          <div class:list={['feature-card', { 'feature-card--wide': isWide, 'feature-card--lead': isWide, 'feature-card--cover': isCover }]}>
            {isCover ? (
              <div class="feature-card-bg" aria-hidden="true">
                <Media media={f.image} alt="" shape="card" size={320} />
              </div>
            ) : icon ? (
              <div class:list={['card-icon', { 'card-icon--lg': isWide }]} aria-hidden="true">
                <svg {...iconSvgProps(icon)}>
                  {icon.paths.map((d) => <path d={d} />)}
                </svg>
              </div>
            ) : f.image ? (
              <Media media={f.image} alt={f.title} shape="card" size={isWide ? 96 : 64} />
            ) : null}
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
