---
// src/components/landing-sections/highlights.astro
// Landing section: key facts row (product-info `highlights`).
// Rendered by ProductLandingDefault via the section registry.
//
// Supports a simple-to-rich range via `data.variant`:
//   - variant: "badge" (default) - inline label/value pairs, no cards, no
//     header. Suits the hero continuation pattern (a compact trust strip
//     right under the hero, Stripe/Vercel style).
//   - variant: "card" - the small bordered cards with an optional header
//     (data.eyebrow / data.title), for a standalone informational section.
// Data may be either an array of {label,value} or
// { variant?, eyebrow?, title?, items: [{label,value}] }.
import type { LandingSectionProps } from '../../lib/landing-sections';

interface Props extends LandingSectionProps {}
const { data } = Astro.props as Props;

const cfg = (data && typeof data === 'object' && !Array.isArray(data) ? data : {}) as {
  variant?: 'badge' | 'card';
  eyebrow?: string;
  title?: string;
  items?: { label: string; value: string }[];
};
const highlights = Array.isArray(data)
  ? (data as { label: string; value: string }[])
  : cfg.items ?? [];
if (highlights.length === 0) return null;

const variant = cfg.variant ?? 'badge';
---

{variant === 'badge' ? (
  <section class="section">
    <div class="container">
      <div class="highlight-badges">
        {highlights.map((h) => (
          <span class="highlight-badge">
            <span class="highlight-badge-value">{h.value}</span>
            <span class="highlight-badge-label">{h.label}</span>
          </span>
        ))}
      </div>
    </div>
  </section>
) : (
  <section class="section">
    <div class="container">
      {(cfg.eyebrow || cfg.title) && (
        <div class="section-header">
          {cfg.eyebrow && <p class="eyebrow">{cfg.eyebrow}</p>}
          {cfg.title && <h2>{cfg.title}</h2>}
        </div>
      )}
      <div class="product-highlights">
        {highlights.map((h) => (
          <div class="product-highlight">
            <div class="product-highlight-value">{h.value}</div>
            <div class="product-highlight-label">{h.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
