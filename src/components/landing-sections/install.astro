---
// src/components/landing-sections/install.astro
// Landing section: install snippet in a terminal frame (product-info
// `install`). Rendered by ProductLandingDefault via the section registry.
import type { LandingSectionProps } from '../../lib/landing-sections';

interface Props extends LandingSectionProps {}
const { data } = Astro.props as Props;
const install = typeof data === 'string' ? data : '';
if (!install) return null;
---

<section class="section section-alt">
  <div class="container">
    <div class="terminal product-install-terminal">
      <div class="terminal-header"><span></span><span></span><span></span></div>
      <div class="terminal-body"><code>{install}</code></div>
    </div>
  </div>
</section>
