---
// src/components/landing-sections/cta.astro
// Landing section: closing CTA box. Defaults to the shared productCopy
// labels (primary -> GitHub, secondary -> docs). A product author can
// override either action via the section `data`:
//   - type: cta
//     data:
//       primary: { label: "Get Started", href: "/json-server/docs/getting-started" }
//       secondary: { label: "View Source", href: "https://github.com/typicode/json-server" }
// hrefs are passed through withBase/localizePath by the renderer if relative
// (i.e. starting with '/'); absolute URLs (http...) are used as-is.
import type { LandingSectionProps } from '../../lib/landing-sections';
import { withBase, localizePath } from '../../lib/i18n';

interface Props extends LandingSectionProps {}
const { product, c, docsHref, locale, data } = Astro.props as Props;

const cfg = (data && typeof data === 'object' ? data : {}) as {
  primary?: { label?: string; href?: string };
  secondary?: { label?: string; href?: string };
};

// Resolve a link: relative paths get withBase(localizePath(...)); absolute
// URLs are returned unchanged.
function resolveHref(href: string | undefined, fallback: string): string {
  if (!href) return fallback;
  return href.startsWith('/') ? withBase(localizePath(href, locale)) : href;
}

const primaryHref = resolveHref(cfg.primary?.href, product.github);
const secondaryHref = resolveHref(cfg.secondary?.href, docsHref);
const primaryLabel = cfg.primary?.label ?? c.ctaPrimary;
const secondaryLabel = cfg.secondary?.label ?? c.readDocs;
const primaryExternal = primaryHref.startsWith('http');
const secondaryExternal = secondaryHref.startsWith('http');
---

<section class="section">
  <div class="container">
    <div class="cta-box">
      <h2>{c.ctaTitle}</h2>
      <p>{c.ctaBody}</p>
      <div class="cta-actions">
        <a href={primaryHref} class="btn btn-primary btn-large" target={primaryExternal ? '_blank' : undefined} rel={primaryExternal ? 'noopener' : undefined}>{primaryLabel}</a>
        <a href={secondaryHref} class="btn btn-secondary btn-large" target={secondaryExternal ? '_blank' : undefined} rel={secondaryExternal ? 'noopener' : undefined}>{secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>
