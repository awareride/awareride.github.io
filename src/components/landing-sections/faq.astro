---
// src/components/landing-sections/faq.astro
// Landing section: FAQ accordion built on native <details>/<summary> (no JS).
// Data is a list of { q, a } pairs declared in product-info frontmatter under
// the `faq` section type. The optional `data.title` / `data.eyebrow` override
// the section header; default header copy is localized.
import type { LandingSectionProps } from '../../lib/landing-sections';

interface Props extends LandingSectionProps {}
const { data, locale } = Astro.props as Props;

const cfg = (data && typeof data === 'object' ? data : {}) as
  | { title?: string; eyebrow?: string; items?: { q: string; a: string }[] }
  | { q: string; a: string }[]
  | undefined;

// Accept either an array of {q,a} directly, or an object with an `items` list.
const items = Array.isArray(cfg)
  ? cfg
  : (cfg?.items ?? []);
if (!Array.isArray(items) || items.length === 0) return null;

const header = !Array.isArray(cfg) && (cfg?.title || cfg?.eyebrow)
  ? { title: cfg.title, eyebrow: cfg.eyebrow }
  : null;
const copy = {
  en: { eyebrow: 'FAQ', title: 'Frequently asked questions' },
  'zh-Hans': { eyebrow: '常见问题', title: '常见问题解答' },
}[locale] ?? { en: { eyebrow: 'FAQ', title: 'Frequently asked questions' } }['en'];
const title = header?.title ?? copy.title;
const eyebrow = header?.eyebrow ?? copy.eyebrow;
---

<section class="section">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <div class="faq-list">
      {items.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
