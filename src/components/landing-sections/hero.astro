---
// src/components/landing-sections/hero.astro
// Landing section: product hero (badge + name + tagline + actions).
// Rendered by ProductLandingDefault via the section registry. The tagline
// comes from the product-info `tagline` field (passed as data by the
// renderer). Markup and classes mirror the original ProductLandingDefault
// hero exactly, so output is behavior-identical.
import type { LandingSectionProps } from '../../lib/landing-sections';

interface Props extends LandingSectionProps {}
const { product, docsHref, c, data } = Astro.props as Props;
// Data shape: { tagline: string, links: {label,href}[] } - resolved by the
// renderer from the product-info `tagline` + `links` fields.
const hero = (data && typeof data === 'object' ? data : { tagline: '', links: [] }) as {
  tagline: string;
  links: { label: string; href: string }[];
};
const { tagline, links } = hero;
void product;
---

<section class="product-hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-glow hero-glow-2" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-badge" style="display:inline-block; font-size:0.85rem; font-weight:600; padding:0.25rem 0.9rem; border-radius:100px; background:var(--color-accent-subtle); color:var(--color-accent); margin-bottom:1.25rem;">
      {c.heroBadge}
    </div>
    <h1>{product.name}</h1>
    {tagline && <p class="hero-lead">{tagline}</p>}
    <div class="hero-actions">
      <a href={product.github} class="btn btn-primary" target="_blank" rel="noopener">{c.viewSource}</a>
      <a href={docsHref} class="btn btn-secondary">{c.documentation}</a>
      {
        // Extra product links (from product-info `links`), if any.
        links.map((l: { label: string; href: string }) => (
          <a href={l.href} class="btn btn-secondary" target="_blank" rel="noopener">{l.label}</a>
        ))
      }
    </div>
  </div>
</section>
