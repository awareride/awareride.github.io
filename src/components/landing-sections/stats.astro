---
// src/components/landing-sections/stats.astro
// Landing section: social-proof metrics row (GitHub stars, npm downloads,
// license, contributors, ...). Data is a list of { label, value } pairs,
// declared in product-info frontmatter under the `stats` section type.
//
// Distinct from the small bordered `highlights` cards: large brand-gold
// gradient numbers separated by thin dividers, on the alt background.
// An optional header (eyebrow + title) leads the section; defaults to
// localized copy, overridable via data: { title, eyebrow }.
import type { LandingSectionProps } from '../../lib/landing-sections';

interface Props extends LandingSectionProps {}
const { data, locale } = Astro.props as Props;
const cfg = (data && typeof data === 'object' && !Array.isArray(data) ? data : {}) as {
  title?: string;
  eyebrow?: string;
  items?: { label: string; value: string }[];
};
const stats = Array.isArray(data)
  ? (data as { label: string; value: string }[])
  : cfg.items ?? [];
if (stats.length === 0) return null;

const copy = {
  en: { eyebrow: 'By the numbers', title: 'Adopted by teams everywhere' },
  'zh-Hans': { eyebrow: '数据一览', title: '被全球团队广泛采用' },
}[locale] ?? { en: { eyebrow: 'By the numbers', title: 'Adopted by teams everywhere' } }['en'];
const title = cfg.title ?? copy.title;
const eyebrow = cfg.eyebrow ?? copy.eyebrow;
---

<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <div class="stats-row">
      {stats.map((s) => (
        <div class="stats-item">
          <div class="stats-value">{s.value}</div>
          <div class="stats-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
