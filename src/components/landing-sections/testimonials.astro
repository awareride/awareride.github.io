---
// src/components/landing-sections/testimonials.astro
// Landing section: social-proof quote cards. Data is a list of
// { quote, author, role, avatar?, rating?, company? } declared in
// product-info frontmatter under the `testimonials` section type.
//
// `avatar` uses the shared media model (src | fallback+gradient), rendered
// as a round chip by Media.astro - the zero-asset treatment needs no image
// files. Optional extra fields: `rating` (1-5, renders star glyphs) and
// `company` (a one-line org label under the role). All optional - a card
// works with just quote + author.
import type { LandingSectionProps } from '../../lib/landing-sections';
import Media from '../Media.astro';

interface Props extends LandingSectionProps {}
const { data, locale } = Astro.props as Props;
const cfg = (data && typeof data === 'object' && !Array.isArray(data) ? data : {}) as {
  layout?: 'masonry' | 'grid';
  eyebrow?: string;
  title?: string;
  items?: { quote: string; author: string; role: string; avatar?: unknown; rating?: number; company?: string }[];
};
const items = Array.isArray(data)
  ? (data as { quote: string; author: string; role: string; avatar?: unknown; rating?: number; company?: string }[])
  : cfg.items ?? [];
if (items.length === 0) return null;
const layout = cfg.layout ?? 'masonry';
const eyebrow = cfg.eyebrow;
const title = cfg.title;
// Localized header copy for the testimonials block.
const copy = {
  en: { eyebrow: 'Loved by developers', title: 'What the community says' },
  'zh-Hans': { eyebrow: '开发者口碑', title: '社区怎么说' },
}[locale] ?? { en: { eyebrow: 'Loved by developers', title: 'What the community says' } }['en'];
const headerEyebrow = eyebrow ?? copy.eyebrow;
const headerTitle = title ?? copy.title;
---

<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">{headerEyebrow}</p>
      <h2>{headerTitle}</h2>
    </div>
    <div class:list={['testimonials-grid', { 'testimonials-grid--masonry': layout === 'masonry' }]}>
      {items.map((t) => (
        <blockquote class="testimonial-card">
          <p class="testimonial-quote">“{t.quote}”</p>
          <footer class="testimonial-author">
            {t.avatar && (
              <Media media={t.avatar} alt={t.author} shape="round" size={44} />
            )}
            <div class="testimonial-author-text">
              <span class="testimonial-name">{t.author}</span>
              {t.company && <span class="testimonial-company">{t.company}</span>}
              <span class="testimonial-role">{t.role}</span>
            </div>
          </footer>
          {t.rating && t.rating > 0 && (
            <p class="testimonial-rating" aria-label={`${t.rating} out of 5`}>
              {'★'.repeat(Math.min(5, t.rating))}
              {'☆'.repeat(Math.max(0, 5 - Math.min(5, t.rating)))}
            </p>
          )}
        </blockquote>
      ))}
    </div>
  </div>
</section>
