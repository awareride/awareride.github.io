---
// src/components/PostCard.astro
//
// The card is an <article> (NOT a single <a>) so that the tag links inside it
// are valid. The main link is the title <a>, stretched over the whole card via
// a ::after pseudo-element (the "stretched link" pattern). Tag links sit above
// it with position:relative + z-index:1 so they remain independently clickable.
import { localizePath, withBase, t, localeCode, type Locale } from '../lib/i18n';
import { tagSlug } from '../lib/content';

export interface Props {
  title: string;
  date: Date;
  description: string;
  tags: string[];
  slug: string;
  source?: string | null;
  locale?: Locale;
  isFallback?: boolean;
}

const {
  title,
  date,
  description,
  tags,
  slug,
  source,
  locale = 'en',
  isFallback = false,
} = Astro.props;

const ui = t[locale];

const formattedDate = date.toLocaleDateString(localeCode[locale], {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const href = withBase(localizePath(`/posts/${slug}`, locale));
---

<article class="post-card">
  {source && <span class="post-card-source">{source}</span>}
  <time class="post-card-date" datetime={date.toISOString()}>{formattedDate}</time>
  <h3>
    <a href={href} class="post-card-link">
      {title}
      {isFallback && <span class="post-card-fallback" title={ui.noTranslation}>EN</span>}
    </a>
  </h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <div class="post-card-tags">
      {tags.map(tag => (
        <a class="tag" href={withBase(localizePath(`/posts/tags/${tagSlug(tag)}`, locale))}>{tag}</a>
      ))}
    </div>
  )}
</article>
