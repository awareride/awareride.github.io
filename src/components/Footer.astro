---
// src/components/Footer.astro
// Site footer. Columns come from site.config.ts `site.footer.links` (one
// column per entry, rendered after the brand block). A Products column
// ({ type: 'products' }) renders from the products registry, optionally
// capped by `limit` with a trailing "All products" link to the catalog.
// Locale is inferred from the URL pathname, matching Nav.
import { localeFromPath, localizePath, withBase, t, siteName } from '../lib/i18n';
import { products, site } from '../../site.config';

const locale = localeFromPath(Astro.url.pathname);
const ui = t[locale];
const homeHref = withBase(localizePath('/', locale));
const footerColumns = site.footer.links;
// Resolve a footer link href: internal links are base- and locale-prefixed,
// external links (http) are used as-is.
const footerLinkHref = (href: string) =>
  href.startsWith('http') ? href : withBase(localizePath(href, locale));
// A column is a custom list of links, or the auto-generated Products column
// (driven by the products registry).
const isProductsColumn = (col: (typeof footerColumns)[number]) => col.type === 'products';
// Products shown in a Products column: featured-only by default (matching the
// nav dropdown), or every product when `all: true`; capped by `limit` when set.
const visibleProducts = (col: (typeof footerColumns)[number]) => {
  if (!isProductsColumn(col)) return [];
  const source = col.all ? products : products.filter((p) => p.featured);
  return col.limit !== undefined ? source.slice(0, col.limit) : source;
};
// "All products" appears when a Products column caps the list and there are
// more products than the limit.
const showAllProducts = (col: (typeof footerColumns)[number]) => {
  if (!isProductsColumn(col)) return false;
  const source = col.all ? products : products.filter((p) => p.featured);
  return col.limit !== undefined && source.length > col.limit;
};
const productsCatalogHref = withBase(localizePath('/products', locale));
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a href={homeHref} class="logo">
        <span class="logo-mark"><img src={withBase('/images/logo.png')} alt="" width="28" height="28" /></span>
        <span class="logo-text">{siteName}</span>
      </a>
      <p class="footer-tagline">{ui.footerTagline}</p>
    </div>
    {
      footerColumns.map((col) =>
        isProductsColumn(col) ? (
          <div>
            <h4>{ui.products}</h4>
            <ul class="footer-links">
              {visibleProducts(col).map((p) => (
                <li><a href={withBase(localizePath(`/${p.slug}`, locale))}>{p.name}</a></li>
              ))}
              {showAllProducts(col) && (
                <li><a href={productsCatalogHref}>{ui.viewAllProducts} →</a></li>
              )}
            </ul>
          </div>
        ) : (
          <div>
            <h4>{col.title[locale]}</h4>
            <ul class="footer-links">
              {col.items.map((item) => (
                <li>
                  <a
                    href={footerLinkHref(item.href)}
                    target={item.external ? '_blank' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    {item.label[locale]}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ),
      )
    }
  </div>
  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} {siteName}. {ui.builtWith}</p>
  </div>
</footer>
