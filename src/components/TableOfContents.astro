---
// src/components/TableOfContents.astro
// Right-rail table of contents for docs pages. Built from the `headings`
// returned by Astro's render() (already slug-populated by Sätteri + our
// heading-ids plugin), filtered to h2/h3 (h1 is the page title, h4+ is too
// granular for a TOC). Active section is highlighted via IntersectionObserver.
//
// Headings come from the *rendered body's* source language, which matches the
// nav/headings we pass in from renderLocalizedPage (already language-correct,
// including fallback pages).
import type { MarkdownHeading } from '../lib/content';

export interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// h2/h3 only - keeps the TOC scannable. h1 is the page title (already shown).
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = toc.length >= 2;
---

{hasToc && (
  <nav class="docs-toc" aria-label="Table of contents">
    <p class="docs-toc-title">On this page</p>
    <ul class="docs-toc-list">
      {toc.map((h) => (
        <li class:list={['docs-toc-item', `depth-${h.depth}`]}>
          <a href={`#${h.slug}`} data-toc-link>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  // Highlight the TOC entry for the section currently in view. Uses
  // IntersectionObserver on the heading targets; the last one to enter from
  // below is the "active" section. Re-runs on every page load (full nav).
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length > 0) {
    const bySlug = new Map<string, HTMLAnchorElement>();
    const targets: Element[] = [];
    links.forEach((a) => {
      const id = a.getAttribute('href')?.slice(1);
      if (!id) return;
      const el = document.getElementById(id);
      if (el) {
        bySlug.set(id, a);
        targets.push(el);
      }
    });

    const setActive = (slug: string | null) => {
      bySlug.forEach((a) => a.classList.remove('active'));
      if (slug) bySlug.get(slug)?.classList.add('active');
    };

    const observer = new IntersectionObserver(
      (entries) => {
        // Pick the topmost entry that is intersecting; fall back to leaving.
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) {
          setActive(visible[0].target.id);
        }
      },
      // Trigger when a heading is near the top third of the viewport.
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
    );

    targets.forEach((t) => observer.observe(t));
    // Default to the first section active before any scroll.
    if (targets[0]) setActive(targets[0].id);
  }
</script>
