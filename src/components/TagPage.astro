---
// src/components/TagPage.astro
// Shared layout for a tag listing page (/posts/tags/[tag] and its zh twin).
// Renders the tag label, a count, and the grid of PostCards. Both locales
// delegate here so the only per-locale difference is the route + UI strings.
import Layout from './Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import PostCard from './PostCard.astro';
import { type Locale, localizePath, withBase, t } from '../lib/i18n';
import type { TagInfo } from '../lib/content';
import type { PostEntryLike } from '../lib/content';

export interface Props {
  tag: TagInfo;
  posts: { entry: PostEntryLike; isFallback: boolean }[];
  locale: Locale;
  alternates: Record<string, string>;
}

const { tag, posts, locale, alternates } = Astro.props;
const ui = t[locale];
const postsHref = withBase(localizePath('/posts', locale));
const eyebrow = ui.tagEyebrow;
const lead = ui.tagLead
  .replace('{n}', String(posts.length))
  .replace('{s}', posts.length === 1 ? '' : 's');
const description = ui.tagDescription.replace('{label}', tag.label);

function dirname(id: string) {
  const parts = id.split('/');
  return parts.length > 1 ? parts.slice(0, -1).join('/') : null;
}
---

<Layout title={`${tag.label} - ${ui.posts}`} description={description} locale={locale} alternates={alternates}>
  <Nav alternates={alternates} />

  <main data-pagefind-body>
    <section class="hero" style="padding-bottom: 2rem;">
      <div class="container">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{tag.label}</h1>
        <p class="hero-lead" style="margin-top: 0.5rem;">{lead}</p>
      </div>
    </section>

    <section class="section" style="padding-top: 1rem;">
      <div class="container">
        <a href={postsHref} class="article-back" style="margin-bottom: 1.5rem; display: inline-block;">← {ui.posts}</a>
        {posts.length === 0 ? (
          <p style="text-align:center; color:var(--color-text-muted);">
            {ui.noPages}
          </p>
        ) : (
          <div class="posts-grid">
            {posts.map(({ entry, isFallback }) => (
              <PostCard
                title={entry.data.title}
                date={entry.data.date}
                description={entry.data.description}
                tags={entry.data.tags}
                slug={entry.id}
                source={dirname(entry.id)}
                isFallback={isFallback}
                locale={locale}
              />
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
