{
  "name": "awareride.github.io",
  "version": "1.0.0",
  "type": "module",
  "description": "AwareRide open source hub — landing page, product showcase, and technical docs, rebuilt on the astro-content-hub template.",
  "scripts": {
    "dev": "node scripts/ensure-pagefind-public.mjs && astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && npm run search:index",
    "search:index": "pagefind --site dist && node scripts/sync-pagefind-public.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "validate:content": "node skills/site-content/scripts/validate-hub-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awareride/awareride.github.io.git"
  },
  "keywords": [
    "open-source",
    "perception",
    "spatial-intelligence",
    "wellness",
    "content-hub"
  ],
  "author": "AwareRide",
  "license": "MIT",
  "homepage": "https://open.awareride.com",
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.1.1",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "fast-uri": "^4.1.2"
  }
}
